# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mali_musavir

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-key
JWT_REFRESH_SECRET=change-this-to-another-very-long-random-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_REGISTRATION_ENABLED=false
# Local dev: secure=false/samesite=lax. Production cross-site frontend/API: secure=true/samesite=none.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mali-musavir-docs
S3_REGION=tr-east-1
DOCUMENT_UPLOAD_MAX_BYTES=104857600

# Email (SMTP / SES)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=
SMTP_FROM=Mali Müşavir <noreply@example.com>

# App
NODE_ENV=development
API_PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional comma-separated suffixes for preview domains, e.g. .your-team.vercel.app
CORS_ALLOWED_SUFFIXES=

# Encryption (AES-256-GCM for sensitive fields). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-this-to-a-32-byte-base64-key

# Google Drive yedekleme (Faturalar modülü). Google Cloud Console > OAuth 2.0 Client ID (Web).
# Redirect URI tam olarak API adresiniz + /api/v1/agent/drive/oauth/callback olmalı.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/agent/drive/oauth/callback
# FATURALAR kök klasörünün açılacağı üst klasör id'si (Drive URL'inden /folders/<ID>).
# Boş bırakılırsa Drive kökünde açılır. Moren: MÜKELLEF LİSTESİ klasörü.
GOOGLE_DRIVE_ROOT_PARENT_ID=

# Local desktop/browser agents. Use random 32+ byte tokens, not tenant slug/id.
# Format: tenantId:randomToken,tenantId2:randomToken2
AGENT_INGEST_TOKENS=
AGENT_TOKEN_ALLOW_TENANT_ID=false

# WhatsApp — Meta Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
# 1) developers.facebook.com → App oluştur → WhatsApp ürünü ekle
# 2) Test numarası veya onaylı gerçek numaradan PHONE_NUMBER_ID al
# 3) System User access token oluştur (whatsapp_business_messaging + whatsapp_business_management scope)
# 4) Business Manager'da şablon (template) gönder ve onay bekle (~5-60 dk)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=evrak_hatirlatma    # Meta'da onaylı şablon adı (opsiyonel ama 24s dışı için şart)
WHATSAPP_DOCUMENT_TEMPLATE_NAME=evrak_hatirlatma
WHATSAPP_PORTAL_TEMPLATE_NAME=portal_mesaji
WHATSAPP_OWNER_ALERT_TEMPLATE_NAME=ofis_uyari
WHATSAPP_TEMPLATE_LANG=tr                   # Şablon dil kodu (tr | en | vb.)
WHATSAPP_API_VERSION=v20.0                  # Graph API versiyonu (sadece doğrudan Meta modunda)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-this-webhook-token

# ── Kapso üzerinden gönderim (numara Kapso'da barındırılıyorsa) ──
# Ayarlanırsa giden mesajlar doğrudan Meta yerine Kapso API'siyle gönderilir.
# Bu durumda WHATSAPP_ACCESS_TOKEN = Kapso API Key, WHATSAPP_PHONE_NUMBER_ID = Kapso numara ID'si olmalı.
# Auth otomatik X-API-Key'e döner, sürüm v24.0 kullanılır.
WHATSAPP_PROVIDER_BASE_URL=                  # örn: https://api.kapso.ai/meta/whatsapp (boş = doğrudan Meta)
# WHATSAPP_PROVIDER_API_VERSION=v24.0        # opsiyonel, Kapso sürümü (varsayılan v24.0)

# ── Bot Veri API'si (dış WhatsApp botu portal verisine erişsin diye) ──
# Kapso'daki AI agent, /api/v1/bot/taxpayer-context ucunu bu anahtarla çağırır.
# Güçlü rastgele bir değer üret; AYNI değeri Kapso fonksiyon secret'ı olarak da gir.
# Boş bırakılırsa bot veri API'si tüm istekleri reddeder (güvenli varsayılan).
BOT_API_KEY=
MOREN_OWNER_WHATSAPP_PHONES=905350000000
MOREN_OWNER_TENANT_SLUG=moren
MOREN_OWNER_DISPLAY_NAME=Muzaffer
# Kayitli olmayan numaralar da Mesajlar ekranina "Kayitsiz WhatsApp ..." olarak duser.
# Daha sonra Mesajlar ekranindan mukellef kaydina baglanabilir.
WHATSAPP_ACCEPT_UNKNOWN_CONTACTS=1
# Musteri mesajlarina otomatik AI cevap kapaliysa bile kayitli numaralar Mesajlar'a duser.
MOREN_CLIENT_BOT_ENABLED=0
# Ofis sahibinden gelen mesajlar portala kaydedilir; otomatik bot cevabini kapatmak icin 0 yap.
MOREN_OWNER_BOT_REPLY_ENABLED=1

# Mihsap fatura isleyici maliyet optimizasyonu
# shadow: ucuz sistem calisir ama sonucu degistirmez; balanced: guvenli ucuz karar Claude'u atlar; claude_only: eski akisa doner
MIHSAP_DECISION_MODE=shadow
MIHSAP_OCR_PROVIDER=auto                    # auto | azure | mistral | none
MIHSAP_CHEAP_MODEL_PROVIDER=auto            # auto | gemini | openai
MIHSAP_MIN_CONFIDENCE=0.82
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Sunucu uzerinde gece/manual portal belge toplama runner'i
# Manuel butona basilinca job kuyruga girer ve runner hemen uyandirilir.
# Bos birakilirsa production'da aktif, local development'ta pasif kabul edilir.
PORTAL_AUTOMATION_RAILWAY_RUNNER_ENABLED=false
PORTAL_AUTOMATION_RAILWAY_RUNNER_INCLUDE_NIGHTLY=true
PORTAL_AUTOMATION_RAILWAY_DEVICE_ID=railway-portal-runner
PORTAL_AUTOMATION_RAILWAY_RUNNER_JOB_TYPES=EBEYANNAME_DAILY_DOWNLOAD,E_TEBLIGAT_CHECK,SGK_HIZMET_LISTESI,SGK_TAHAKKUK,SGK_ISE_GIRIS_CIKIS,SGK_ISGOREMEZLIK
PORTAL_AUTOMATION_RAILWAY_RUNNER_BATCH=1
PORTAL_AUTOMATION_RAILWAY_RUNNER_TIMEOUT_MIN=45

# Portal giris / hedef ekran URL'leri degisirse env'den duzeltilebilir.
PORTAL_AUTOMATION_EBEYANNAME_LOGIN_URL=https://ebeyanname.gib.gov.tr/giris.html
PORTAL_AUTOMATION_GIB_IVD_LOGIN_URL=https://dijital.gib.gov.tr/
PORTAL_AUTOMATION_SGK_LOGIN_URL=https://uyg.sgk.gov.tr/
PORTAL_AUTOMATION_EBEYANNAME_LIST_URL=
PORTAL_AUTOMATION_ETEBLIGAT_LIST_URL=
PORTAL_AUTOMATION_SGK_HIZMET_LISTESI_URL=
PORTAL_AUTOMATION_SGK_TAHAKKUK_URL=
PORTAL_AUTOMATION_SGK_ISE_GIRIS_CIKIS_URL=
PORTAL_AUTOMATION_SGK_ISGOREMEZLIK_URL=
PORTAL_AUTOMATION_DOCUMENT_MAX_DOWNLOADS=20

# ── Moren AI Otomasyon Motoru (Otomasyonlarım modülü) ──
# Tenant başına aylık AI bütçe tavanı (USD). Bu ayki harcama aşılırsa yeni çalışmalar
# reddedilir + sahibe bildirim düşer. Boş/0 = limitsiz (varsayılan).
AUTOMATIONS_MONTHLY_BUDGET_USD=
# Çok kopyalı (replica > 1) kurulumda çift tetiklemeyi önlemek için: cron/event
# zamanlayıcısı YALNIZ bir kopyada açık olmalı. Diğer kopyalarda 'false' yap.
AUTOMATIONS_SCHEDULER_ENABLED=true
# Webhook tetikleyiciyi açar (varsayılan kapalı — secret/dış tetikleme akışı tam değil).
AUTOMATIONS_ENABLE_WEBHOOKS=false
# Parser modeli (varsayılan claude-sonnet-4-6). İstenirse Haiku'ya düşürülebilir.
AUTOMATION_PARSER_MODEL=claude-sonnet-4-6
