{
  "manifest_version": 3,
  "name": "Moren Auto Agent",
  "version": "1.0.8",
  "description": "Luca + Mihsap sayfalarına Moren Agent'ı otomatik enjekte eder, portal'dan tek tuş kontrol sağlar.",
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://auygs.luca.com.tr/*",
    "https://*.luca.com.tr/*",
    "https://app.mihsap.com/*",
    "https://*.morenmusavirlik.com/*",
    "https://mali-musavir-app-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://auygs.luca.com.tr/*",
        "https://*.luca.com.tr/*",
        "https://app.mihsap.com/*",
        "https://portal.morenmusavirlik.com/*",
        "https://*.morenmusavirlik.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["device-id-injector.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://auygs.luca.com.tr/*",
        "https://*.luca.com.tr/*"
      ],
      "js": ["inject-luca.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.mihsap.com/*"
      ],
      "js": ["inject-mihsap.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://portal.morenmusavirlik.com/*",
        "https://*.morenmusavirlik.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["portal-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://portal.morenmusavirlik.com/*",
        "https://*.morenmusavirlik.com/*",
        "http://localhost:3000/*"
      ],
      "js": ["portal-relay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Moren Auto Agent"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
