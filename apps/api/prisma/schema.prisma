  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, mukellef])
  @@index([tenantId])
  @@map("agent_rules")
}

model AgentStatus {
  id        String   @id @default(cuid())
  tenantId  String
  agent     String
  // Multi-device support: aynı agent için birden çok cihaz (ofis local-agent,
  // Chrome uzantısı, ev PC'si vb.) ayrı satırlarda. "" = legacy default.
  deviceId  String   @default("")
  running   Boolean  @default(false)
  hedefAy   String?
  lastPing  DateTime @default(now())
  meta      Json?
  // Pause/Resume kontrolu - portaldan set edilir, agent okur
  // null veya 'RUNNING' = devam, 'PAUSED' = durdur, 'STOP' = tamamen kapat
  controlState String? @default("RUNNING")
  controlSetBy String?
  controlSetAt DateTime?

  @@unique([tenantId, agent, deviceId])
  @@index([tenantId, agent, lastPing])
  @@map("agent_status")
}

// AI API kullanım takibi — tüm Claude çağrılarında bir kayıt
// source: "mihsap-fatura" | "fis-yazdirma" | diğer modüller
model AiUsageLog {
  id            String   @id @default(cuid())
  tenantId      String
  taxpayerId    String?  // Mükellef foreign key — karlılık raporunda mükellef başına maliyet için
  source        String   @default("mihsap-fatura") // hangi modül çağırdı
  mukellef      String?  // İşlem yapılan mükellef adı (legacy — yeni kayıtlar taxpayerId kullanmalı)
  model         String   // "claude-haiku-4-5-20251001"
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  cacheReadTokens  Int   @default(0)
  cacheWriteTokens Int   @default(0)
  costUsd       Float    @default(0) // Hesaplanan USD maliyet
  karar         String?  // "onay" | "atla" | "emin_degil" | "ok" | "error"
  sebep         String?  @db.VarChar(200)
  belgeNo       String?
  durationMs    Int?     // API çağrı süresi
  // Cache hit ise true → bu çağrıda gerçekten Claude'a gidilmedi, sadece istatistik
  cacheHit      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, karar])
  @@index([tenantId, source, createdAt])
  @@index([tenantId, mukellef, createdAt])
  @@index([tenantId, taxpayerId, createdAt])
  @@map("ai_usage_logs")
}

// Anthropic kontör (credit) yüklemeleri — kalan bakiye hesabı için
model BotQualityLog {
  id             String   @id @default(cuid())
  tenantId       String
  taxpayerId     String?
  conversationId String?
  messageId      String?
  source         String   // ONLINE_EVAL | SYNTHETIC_TEST
  status         String   // PASSED | LOW_SCORE | RETRY_USED | FALLBACK_USED | SYNTHETIC_FAIL | EVAL_WARN
  score          Int      @default(0)
  intent         String?
  reasons        Json     @default("[]")
  originalReply  String?  @db.Text
  finalReply     String?  @db.Text
  retryCount     Int      @default(0)
  fallbackUsed   Boolean  @default(false)
  evalModel      String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costUsd        Float    @default(0)
  scenarioKey    String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, source, createdAt])
  @@map("bot_quality_logs")
}

model BotQualityFeedback {
  id             String   @id @default(cuid())
  tenantId       String
  qualityLogId   String?
  conversationId String?
  messageId      String?
  rating         String   // UP | DOWN
  reason         String?
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, qualityLogId])
  @@map("bot_quality_feedback")
}

model AiCreditTopup {
  id         String   @id @default(cuid())
  tenantId   String
  amountUsd  Float    // Yüklenen tutar (USD)
  note       String?  // Kullanıcı notu (ör. "Nisan yüklemesi")
  addedAt    DateTime @default(now())
  addedBy    String?  // userId

  @@index([tenantId, addedAt])
  @@map("ai_credit_topups")
}

// MOREN AI hafizasi: ofis, portal, mukellef ve ileride mobil uygulama baglamini
// kalici olarak saklar. PII/ozel notlar tenant izolasyonuyla tutulur.
model AiMemory {
  id          String   @id @default(cuid())
  tenantId    String
  taxpayerId  String?
  scope       String   @default("office") // office | taxpayer | portal | mobile | agent
  title       String
  content     String   @db.Text
  source      String?  // moren-ai | user | agent | mobile | system
  importance  Int      @default(3) // 1 dusuk, 5 kritik
  tags        String[] @default([])
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, scope, isActive])
  @@index([tenantId, taxpayerId, isActive])
  @@index([tenantId, updatedAt])
  @@map("ai_memories")
}

// ============================================================
// MIHSAP ENTEGRASYONU
// ============================================================

// MIHSAP oturum token'ı — eklenti tarafından otomatik senkronize edilir
model MihsapSession {
  id           String   @id @default(cuid())
  tenantId     String   @unique  // Her tenant için tek token
  token        String   @db.Text // JWT (şifreli saklanır — AES-GCM)
  email        String?  // Bilgi amaçlı (hangi hesap)
  updatedBy    String?  // userId / "extension"
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("mihsap_sessions")
}

// MIHSAP'tan çekilen faturalar — metadata + storage path
model MihsapInvoice {
  id                 String   @id @default(cuid())
  tenantId           String
  mukellefId         String   // Kendi sistemimizdeki mükellef ID
  mukellefMihsapId   String   // MIHSAP'taki userFirmaBilgisiId
  donem              String   // "2026-03" formatı (yıl-ay)
  faturaTuru         String   // "ALIS" | "SATIS" | "TEVKIFATLI_ALIS" vb.
  belgeTuru          String   // "E_FATURA" | "FIS" | "E_ARSIV" vb.
  faturaNo           String
  firmaKimlikNo      String?  // Karşı firma VKN/TCKN
  firmaUnvan         String?  // Karşı firma adı
  faturaTarihi       DateTime
  toplamTutar        Float
  onayDurumu         String?  // "ONAYLANMIS" vb.
  mihsapId           String   @unique  // MIHSAP'taki id (duplicate koruma)
  mihsapFileId       String?
  mihsapFaturaId     String?
  orjDosyaTuru       String?  // "XML" | "JPEG" vb.
  storageKey         String?  // Railway volume / S3 path: {tenant}/{mukellef}/{ay}/{belgeNo}.jpg
  storageUrl         String?  // Download URL (presigned veya internal)
  mihsapFileLink     String?  // Orijinal MIHSAP link (fallback)
  // Kayit hangi MIHSAP kaynagindan geldi: "arsiv" (Arsivim) | "bekleyen" (gelen evraklar).
  // Islenen Faturalar modulu YALNIZ arsiv kaynakli kayitlari listeler; Fatura Isleme
  // Merkezi'nin "Mihsap'tan Cek"i bekleyen ceker, o kayitlar Islenen Faturalar'da gorunmez.
  kaynak             String?
  downloadedAt       DateTime?
  raw                Json?    // Orijinal MIHSAP payload
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, mukellefId, donem])
  @@index([tenantId, donem, faturaTuru])
  @@index([tenantId, firmaKimlikNo])
  @@map("mihsap_invoices")
}

// Toplu çekme komutları — async çalıştırma + progress takibi
model MihsapFetchJob {
  id          String   @id @default(cuid())
  tenantId    String
  mukellefId  String
  donem       String   // "2026-03"
  faturaTuru  String?  // "ALIS" | "SATIS" | null (ikisi birden)
  status      String   @default("pending") // pending | running | done | failed
  totalCount  Int      @default(0)
  fetchedCount Int     @default(0)
  errorMsg    String?
  createdBy   String?
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("mihsap_fetch_jobs")
}

// ============================================================
// GOOGLE DRIVE YEDEKLEME
// Faturalar modülünden çekilen belgeler Drive'a yedeklenir.
// Klasör: FATURALAR / {mükellef} / {yıl} / {ay} / {Alış|Satış} / dosya
// ============================================================

// Tenant başına Google Drive OAuth bağlantısı.
// refreshToken AES-256-GCM ile şifrelenmiş saklanır (ENCRYPTION_KEY).
model GoogleDriveAccount {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  email                 String?   // Bağlanan Google hesabı
  encryptedRefreshToken String    @db.Text  // AES-GCM şifreli refresh token
  accessToken           String?   @db.Text  // Son erişim token'ı (cache)
  accessTokenExpiresAt  DateTime?
  scope                 String?
  rootFolderId          String?   // "FATURALAR" kök klasör id (cache)
  rootFolderName        String    @default("FATURALAR")
  connectedAt           DateTime?
  lastError             String?
  isActive              Boolean   @default(true)
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("google_drive_accounts")
}

// Drive'a yüklenen faturaların kalıcı kütüğü — mükerrer engeli.
// forceRefresh/clearPeriod MihsapInvoice'u silse de bu KALIR → tekrar yüklenmez.
model DriveBackup {
  id            String   @id @default(cuid())
  tenantId      String
  mihsapId      String   // MihsapInvoice.mihsapId (kaynak fatura kimliği)
  mukellefId    String?
  donem         String?
  faturaTuru    String?  // ALIS | SATIS
  driveFileId   String   // Drive dosya id
  driveFolderId String?  // Bulunduğu klasör id
  filePath      String?  // FATURALAR/.../Alış/dosya.jpg (okunabilirlik)
  fileName      String?
  sizeBytes     Int?
  backedUpAt    DateTime @default(now())

  @@unique([tenantId, mihsapId])
  @@index([tenantId, mukellefId, donem])
  @@map("drive_backups")
}

// Klasör id önbelleği — aynı yolu tekrar tekrar Drive'da aramamak için.
model DriveFolder {
  id            String   @id @default(cuid())
  tenantId      String
  path          String   // "FATURALAR/{mükellef}/2026/04 Nisan/Alış"
  driveFolderId String
  createdAt     DateTime @default(now())

  @@unique([tenantId, path])
  @@map("drive_folders")
}

// Yedekleme işi — ilerleme takibi (MihsapFetchJob deseni).
model DriveBackupJob {
  id            String    @id @default(cuid())
  tenantId      String
  mukellefId    String?
  donem         String?
  status        String    @default("pending") // pending|running|done|failed
  totalCount    Int       @default(0)
  backedUpCount Int       @default(0)
  skippedCount  Int       @default(0)
  failedCount   Int       @default(0)
  errorMsg      String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("drive_backup_jobs")
}

// ============================================================
// LUCA ENTEGRASYONU
// ============================================================

// Luca kullanıcı adı + şifresi — backend Playwright ile otomatik login olur.
// Şifre AES-256-GCM ile şifrelenmiş saklanır; ENCRYPTION_KEY env'den okunur.
model LucaCredential {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  uyeNo             String    // Luca üye numarası (müşavir no)
  username          String    // Luca kullanıcı adı (mali müşavirin hesabı)
  encryptedPassword String    @db.Text  // AES-GCM şifrelenmiş
  // Cache edilmiş session cookies — her istek için yeniden login olmasın
  encryptedCookies  String?   @db.Text  // AES-GCM şifrelenmiş JSON
  cookiesExpiresAt  DateTime?
  lastLoginAt       DateTime?
  lastError         String?   // Son login denemesinde hata varsa
  isActive          Boolean   @default(true)
  updatedBy         String?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())

  @@map("luca_credentials")
}

// Luca oturum token/cookie'si — tarayıcı eklentisi tarafından senkronize edilir
// (Eski bookmarklet akışı için; credential tablosu varsa kullanılmaz)
model LucaSession {
  id          String   @id @default(cuid())
  tenantId    String   @unique   // Her tenant için tek oturum
  token       String   @db.Text  // JWT ya da cookie header değeri
  cookies     String?  @db.Text  // Luca için ek cookie header (PHPSESSID vs.)
  origin      String?            // "web.luca.com.tr" gibi
  email       String?            // Luca hesabı (bilgi amaçlı)
  updatedBy   String?            // userId / "extension"
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("luca_sessions")
}

// Portal icinde Luca guvenlik kodu/CAPTCHA akisi.
// Agent Luca ekraninda CAPTCHA gorurse gorseli buraya yazar; portal kullanicisi
// kodu buradan girer; agent cevabi poll ederek Luca ekranina uygular.
model LucaCaptchaChallenge {
  id           String    @id @default(cuid())
  tenantId     String
  jobId        String?
  deviceId     String?
  status       String    @default("pending") // pending | answered | consumed | expired | cancelled
  captchaImage String    @db.Text
  answer       String?
  context      Json?
  requestedBy  String?
  answeredBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expiresAt    DateTime?
  answeredAt   DateTime?
  consumedAt   DateTime?

  @@index([tenantId, status, createdAt])
  @@index([tenantId, deviceId, status])
  @@index([jobId])
  @@map("luca_captcha_challenges")
}

// ============================================================
// MİZAN / GELİR TABLOSU / BİLANÇO
// ============================================================

// Luca'dan çekilen mizan snapshot'ı (tek dönem için tüm hesap kodları)
model Mizan {
  id          String        @id @default(cuid())
  tenantId    String
  taxpayerId  String
  donem       String        // "2026-03"
  donemTipi   String        @default("AYLIK") // AYLIK | GECICI_Q1 | GECICI_Q2 | GECICI_Q3 | GECICI_Q4 | YILLIK
  kaynak      String        @default("LUCA")  // LUCA | MANUEL | EXCEL
  status      String        @default("READY") // PENDING | READY | FAILED
  notes       String?
  rawExcelKey String?       // Mizan Excel orijinali (arşiv için)
  // Kesin Kayıt (lock) — kilitlendiğinde değişiklik/silme reddedilir
  locked      Boolean       @default(false)
  lockedAt    DateTime?
  lockedBy    String?
  lockNote    String?
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  hesaplar    MizanHesap[]
  gelirTablolari GelirTablosu[]
  bilancolar  Bilanco[]
  anomaliler  MizanAnomali[]

  @@index([tenantId, taxpayerId, donem])
  @@index([tenantId, createdAt])
  @@map("mizanlar")
}

// Mizan içindeki her hesap kodu satırı
model MizanHesap {
  id              String   @id @default(cuid())
  mizanId         String
  hesapKodu       String   // "600", "600.01", "120.01.001" gibi
  hesapAdi        String
  // Alt kırılım seviyesi (kaç nokta var): 0 = ana hesap, 1 = alt, 2 = detay
  seviye          Int      @default(0)
  borcToplami     Decimal  @default(0) @db.Decimal(18, 2)
  alacakToplami   Decimal  @default(0) @db.Decimal(18, 2)
  borcBakiye      Decimal  @default(0) @db.Decimal(18, 2)
  alacakBakiye    Decimal  @default(0) @db.Decimal(18, 2)
  rowIndex        Int      @default(0)

  mizan           Mizan    @relation(fields: [mizanId], references: [id], onDelete: Cascade)

  @@index([mizanId, hesapKodu])
  @@map("mizan_hesaplar")
}

// Mizan denetim sonucu — hesap kodu anomalileri
model MizanAnomali {
  id           String   @id @default(cuid())
  mizanId      String
  hesapKodu    String?
  tip          String   // "TDHP_DISI" | "ZIT_BAKIYE" | "EKSIK_HESAP" | "NET_OLMAYAN"
  seviye       String   @default("WARN") // INFO | WARN | ERROR
  mesaj        String
  detay        Json?

  mizan        Mizan    @relation(fields: [mizanId], references: [id], onDelete: Cascade)

  @@index([mizanId])
  @@map("mizan_anomaliler")
}

// Mizandan üretilen gelir tablosu snapshot'ı
model MizanDenetimKriteri {
  id            String   @id @default(cuid())
  tenantId      String
  ad            String
  aktif         Boolean  @default(true)
  hesapPattern  String
  kosul         String
  esik          Decimal? @db.Decimal(18, 2)
  seviye        String   @default("WARN")
  mesaj         String
  taxpayerId    String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, aktif])
  @@index([tenantId, taxpayerId])
  @@map("mizan_denetim_kriterleri")
}

// e-Defter on kontrol icin Luca Detay Fis Listesi snapshot'i.
// Kaynak yevmiye defteri degil, defter olusmadan once muhasebe fis satirlaridir.
model EDefterControlSession {
  id             String   @id @default(cuid())
  tenantId       String
  taxpayerId     String
  donem          String   // "2026-Q1", "2026-04" veya "2026"
  donemTipi      String   @default("GECICI_Q1") // GECICI_Q1..Q4 | AYLIK | YILLIK
  donemBaslangic DateTime?
  donemBitis     DateTime?
  kaynak         String   @default("LUCA") // LUCA | EXCEL
  status         String   @default("READY") // READY | REVIEWING | FAILED
  totalLines     Int      @default(0)
  totalVouchers  Int      @default(0)
  findingCount   Int      @default(0)
  rawExcelBytes  Bytes?
  rawExcelSize   Int      @default(0)
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines          EDefterVoucherLine[]
  findings       EDefterFinding[]

  @@index([tenantId, taxpayerId, donem])
  @@index([tenantId, createdAt])
  @@map("edefter_control_sessions")
}

model EDefterVoucherLine {
  id            String   @id @default(cuid())
  sessionId     String
  rowIndex      Int      @default(0)
  voucherKey    String
  fisNo         String?
  yevmiyeNo     String?
  fisTarihi     DateTime?
  fisTipi       String?
  evrakNo       String?
  evrakTarihi   DateTime?
  belgeTuru     String?
  hesapKodu     String?
  hesapAdi      String?
  aciklama      String?
  karsiHesap    String?
  vknTckn       String?
  borc          Decimal  @default(0) @db.Decimal(18, 2)
  alacak        Decimal  @default(0) @db.Decimal(18, 2)
  rawData       Json?
  createdAt     DateTime @default(now())

  session       EDefterControlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, voucherKey])
  @@index([sessionId, hesapKodu])
  @@map("edefter_voucher_lines")
}

model EDefterFinding {
  id            String   @id @default(cuid())
  sessionId     String
  severity      String   @default("WARN") // INFO | WARN | ERROR
  category      String
  message       String
  voucherKey    String?
  rowIndex      Int?
  hesapKodu     String?
  detail        Json?
  status        String   @default("OPEN") // OPEN | RESOLVED | IGNORED
  createdAt     DateTime @default(now())

  session       EDefterControlSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, severity])
  @@index([sessionId, category])
  @@map("edefter_findings")
}

model GelirTablosu {
  id           String   @id @default(cuid())
  tenantId     String
  taxpayerId   String
  mizanId      String?  // Hangi mizandan üretildi
  donem        String   // "2026-Q1" | "2026-03" | "2026-YILLIK"
  donemTipi    String   @default("GECICI_Q1")
  donemBaslangic DateTime?
  donemBitis   DateTime?

  // Standart gelir tablosu kalemleri (TDHP)
  brutSatislar       Decimal  @default(0) @db.Decimal(18, 2)
  satisIndirimleri   Decimal  @default(0) @db.Decimal(18, 2)
  netSatislar        Decimal  @default(0) @db.Decimal(18, 2)
  satisMaliyeti      Decimal  @default(0) @db.Decimal(18, 2)
  brutSatisKari      Decimal  @default(0) @db.Decimal(18, 2)
  faaliyetGiderleri  Decimal  @default(0) @db.Decimal(18, 2)
  faaliyetKari       Decimal  @default(0) @db.Decimal(18, 2)
  digerGelirler      Decimal  @default(0) @db.Decimal(18, 2)
  digerGiderler      Decimal  @default(0) @db.Decimal(18, 2)
  finansmanGiderleri Decimal  @default(0) @db.Decimal(18, 2)
  olaganKar          Decimal  @default(0) @db.Decimal(18, 2)
  olaganDisiGelir    Decimal  @default(0) @db.Decimal(18, 2)
  olaganDisiGider    Decimal  @default(0) @db.Decimal(18, 2)
  donemKari          Decimal  @default(0) @db.Decimal(18, 2)
  vergiKarsiligi     Decimal  @default(0) @db.Decimal(18, 2)
  donemNetKari       Decimal  @default(0) @db.Decimal(18, 2)

  // Detay: hangi hesap kodundan hangi tutar geldi (audit için)
  detay        Json?
  // Manuel düzeltmeler: kullanıcı 2. dönem için mizana kaydetmeden önce
  // maliyet/gider tahmini yapabilsin diye — her kalem için ek tutar
  duzeltmeler  Json?
  // Kesin Kayıt — kilitlendiğinde değişiklik/silme reddedilir
  locked       Boolean  @default(false)
  lockedAt     DateTime?
  lockedBy     String?
  lockNote     String?
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mizan        Mizan?   @relation(fields: [mizanId], references: [id], onDelete: SetNull)

  @@index([tenantId, taxpayerId, donem])
  @@index([tenantId, createdAt])
  @@map("gelir_tablolari")
}

// Mizandan üretilen bilanço snapshot'ı
model Bilanco {
  id           String   @id @default(cuid())
  tenantId     String
  taxpayerId   String
  mizanId      String?
  donem        String   // "2026-03"
  donemTipi    String   @default("AYLIK")
  tarih        DateTime?

  // Aktif toplamları (Dönen + Duran = Aktif Toplamı)
  donenVarliklar    Decimal @default(0) @db.Decimal(18, 2)
  duranVarliklar    Decimal @default(0) @db.Decimal(18, 2)
  aktifToplami      Decimal @default(0) @db.Decimal(18, 2)

  // Pasif toplamları (KVYK + UVYK + Özkaynak = Pasif Toplamı)
  kvYabanciKaynak   Decimal @default(0) @db.Decimal(18, 2)
  uvYabanciKaynak   Decimal @default(0) @db.Decimal(18, 2)
  ozkaynaklar       Decimal @default(0) @db.Decimal(18, 2)
  pasifToplami      Decimal @default(0) @db.Decimal(18, 2)

  // Detaylı kırılım (aktif + pasif tam hesap kodu bazlı)
  aktif        Json     // {"10": {...}, "12": {...}, ...}
  pasif        Json
  detay        Json?
  // Kesin Kayıt — kilitlendiğinde değişiklik/silme reddedilir
  locked       Boolean  @default(false)
  lockedAt     DateTime?
  lockedBy     String?
  lockNote     String?
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mizan        Mizan?   @relation(fields: [mizanId], references: [id], onDelete: SetNull)

  @@index([tenantId, taxpayerId, donem])
  @@index([tenantId, createdAt])
  @@map("bilancolar")
}

// KDV Kontrol çıktılarının arşivi — fiş yazdırmadaki gibi geriye dönük erişim
model KdvControlOutput {
  id            String   @id @default(cuid())
  tenantId      String
  sessionId     String?  // Hangi KDV kontrol oturumundan üretildi
  taxpayerId    String?
  mukellefName  String?  // Snapshot — görüntüleme için
  donem         String?  // "2026-02"
  tip           String?  // "KDV_191" | "KDV_391" | "ISLETME_GELIR" | "ISLETME_GIDER"
  matchedCount  Int      @default(0)
  partialCount  Int      @default(0)
  unmatchedCount Int     @default(0)
  totalRecords  Int      @default(0)
  totalImages   Int      @default(0)
  filename      String   // İndirme adı
  fileBytes     Bytes    // Excel dosyasının ikili içeriği
  fileSize      Int      @default(0)
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, taxpayerId, donem])
  @@index([sessionId])
  @@map("kdv_control_outputs")
}

// Luca'dan çekilen komutlar — hangi mükellef/dönem için ne tür muavin alındı
model LucaFetchJob {
  id            String    @id @default(cuid())
  tenantId      String
  sessionId     String?   // Bağlı KDV kontrol oturumu (varsa)
  mukellefId    String
  donem         String    // "2026-03"
  tip           String    // "KDV_191" | "KDV_391" | "ISLETME_GELIR" | "ISLETME_GIDER" | "INVOICE_POST"
  status        String    @default("pending") // pending | running | done | failed
  recordCount   Int       @default(0)
  errorMsg      String?
  targetDeviceId String?
  createdBy     String?
  // Boyut B — Job affinity: hangi ajan tipi tercih edilir
  // null = herkes alabilir, 'local-node' = sadece headless worker,
  // 'browser-ext' = sadece Chrome uzantısı
  preferredAgent String?
  // Boyut C — Priority: yüksek = önce işle (default 0)
  // Beyanname dönemi yaklaşınca portal otomatik 1-5 arası yükseltir
  priority      Int       @default(0)
  // Retry policy — DENİZ patrol direkt iptal etmeden önce 2 kez retry
  // her retry'da nextRetryAt exponential backoff (5dk, 15dk, 45dk)
  retryCount    Int       @default(0)
  nextRetryAt   DateTime?
  // v1.38: INVOICE_POST tipi için iş yükü (belge ID, satırlar vs).
  // Diğer tipler de gelecekte serbest payload taşıyabilir.
  payload       Json?
  // v1.38: INVOICE_POST için bağlı belgeye direct FK index (kolay sorgu)
  invoiceDocumentId String?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, targetDeviceId, status])
  @@index([tenantId, status, priority])
  @@index([sessionId])
  @@index([invoiceDocumentId])
  @@map("luca_fetch_jobs")
}

// Moren Ofis — 6 ajanlık AI ekibi konuşma geçmişi
// Her conversation bir kullanıcı sohbet oturumu; messages JSON array
// (kullanıcı + ajan cevapları, sırasıyla).
model MorenOfisConversation {
  id              String   @id @default(cuid())
  tenantId        String
  createdBy       String
  title           String?
  // OfisMessage[] — see apps/api/src/moren-ofis/moren-ofis.service.ts
  messages        Json     @default("[]")
  // ARDA'nın sohbet sonu üretttiği 1-2 cümle özet — gelecek sohbetlerde
  // yeni sorguya inject edilir (long-term memory).
  summary         String?
  // Sohbet konusu / ana entity (mükellef adı vb.) — filter için
  entities        String[] @default([])
  totalCostUsd    Decimal  @default(0) @db.Decimal(10, 6)
  createdAt       DateTime @default(now())
  lastActivityAt  DateTime @default(now()) @updatedAt

  @@index([tenantId, lastActivityAt])
  @@map("moren_ofis_conversations")
}

// Moren Ofis — Kalıcı gerçekler (long-term facts memory)
// Her gerçek subject-predicate-object yapısında. Örnek:
//   subject="Muzaffer Bey", predicate="tercih_eder", object="detayli ozet"
//   subject="PETRAVET", predicate="geçici_vergi_donemi", object="Q1=433.841 TL"
//   subject="ofis_genel", predicate="aktif_mukellef_sayisi", object="65"
//
// Ajan cevap üretirken ARDA bu gerçekleri context'e enjekte eder.
model MorenOfisFact {
  id              String   @id @default(cuid())
  tenantId        String
  // Gerçeği oluşturan ajan (genelde ARDA, ama her ajan kendi gerçeğini de saklayabilir)
  createdByAgent  String?
  subject         String   // "Ahmet Yılmaz", "ofis", "PETRAVET", "Muzaffer Bey", "muhsap_login"
  predicate       String   // "tercih_eder", "son_kdv_donemi", "ortalama_gelir", "calisan_sayisi"
  object          String   // değer — serbest metin
  // Önem skoru: 1-10 arası. Düşükse zaman içinde silinir.
  importance      Int      @default(5)
  // Kaynağı — hangi conversation'dan çıkarıldı (audit + revoke için)
  sourceConvId    String?
  // Kaç kez context'e yüklendi — popüler olanlar ilk gelir
  accessCount     Int      @default(0)
  lastAccessedAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, subject])
  @@index([tenantId, importance, lastAccessedAt])
  @@unique([tenantId, subject, predicate])
  @@map("moren_ofis_facts")
}

// DENİZ'in öneri/rapor kuyruğu — sistem patrol ve gece analizleri
// Her madde: hata, performans, feature, bakım, veya gece raporu (info)
model MorenOfisProposal {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String   @db.Text
  // Önem: high | medium | low
  priority    String   @default("medium")
  // Tip: bug | perf | feature | maintenance | info (gece raporu)
  category    String   @default("feature")
  // Durum: open | in_progress | done | dismissed | info
  status      String   @default("open")
  // Patron notu eklerse
  patronNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([tenantId, category])
  @@map("moren_ofis_proposals")
}

// Boyut D — Zamanlanmış otomatik Luca işleri
// Cron benzeri: belirlenen aralıkta scheduler servisi LucaFetchJob yaratır.
model ScheduledLucaJob {
  id          String    @id @default(cuid())
  tenantId    String
  name        String    // Kullanıcıya gösterilen ad — "Ay başı tüm mükellefler mizan"
  active      Boolean   @default(true)
  // Cron string (standart 5-field: dakika saat gün ay haftaGünü)
  // Örn: "0 6 1 * *" = her ayın 1'inde 06:00
  cron        String
  // Yaratılacak job parametreleri
  jobTip      String    // "MIZAN" | "ACCOUNT_PLAN" | "EARSIV_ALIS" vb.
  // Mükellef seçimi: null=tüm aktif mükellefler, string[]=spesifik id listesi
  mukellefIds String[]  @default([])
  // İlave parametreler (donem hesaplama vb.)
  options     Json?
  preferredAgent String?
  priority    Int       @default(0)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, active, nextRunAt])
  @@map("scheduled_luca_jobs")
}

// Fiş Yazdırma: oluşturulan Word çıktılarının arşivi
model FisYazdirmaOutput {
  id            String   @id @default(cuid())
  tenantId      String
  mukellefId    String?  // Seçili mükellef (varsa)
  mukellefName  String?  // Snapshot — görüntüleme için
  donem         String?  // "2026-02" (varsa)
  fileCount     Int      @default(0)
  pagesPerSheet Int?
  filename      String   // İndirme sırasında kullanılan orijinal ad
  fileBytes     Bytes    // Word belgesinin ikili içeriği
  fileSize      Int      @default(0)
  createdBy     String?
  createdAt     DateTime @default(now())

  // Otomatik yazdırma — lokal agent tarafından pull edilir
  printStatus   String?  // null | "REQUESTED" | "PRINTING" | "DONE" | "FAILED"
  printedAt     DateTime?
  printError    String?  // hata olursa mesaj
  printDeviceId String?  // hangi agent yazdıracak (null = ilk uygun cihaz)

  @@index([tenantId, createdAt])
  @@index([tenantId, mukellefId, donem])
  @@index([printStatus]) // agent pending sorgusu icin
