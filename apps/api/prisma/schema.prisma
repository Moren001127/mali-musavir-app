  isletmeGiderTuru String?  // IsletmeGiderTurleri.kod — gider/gelir türü
  isletmeMatrah    Decimal? @db.Decimal(14, 2)  // bilgi amaçlı (deftere yazılmaz, VUK kuralı)

  updatedAt   DateTime @updatedAt

  document    InvoiceAccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

