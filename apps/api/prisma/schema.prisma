generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANT (Ofis / Multi-tenant izolasyon)
// ============================================================
model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  address     String?
  // Galeri HGS ihlal sorgu sonuc ozetinin gonderilecegi WhatsApp numaralari.
  // Bos ise runner'daki eski sabit liste / owner devreye girer.
  galeriHgsPhones String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                 User[]
  taxpayers             Taxpayer[]
  integrationConnections IntegrationConnection[]
  portalCredentials      PortalCredential[]
  portalAutomationJobs   PortalAutomationJob[]
  portalDocuments        PortalDocument[]
  consents              Consent[]
  dataRetentionPolicies DataRetentionPolicy[]
  notifications         Notification[]
  officeChatThreads     OfficeChatThread[]
  kdvSessions           KdvControlSession[]
  smsTemplate           SmsTemplate?
  officeBudgetCategories OfficeBudgetCategory[]
  officeBudgetEntries    OfficeBudgetEntry[]
  officeBudgetPlans      OfficeBudgetPlan[]
  officeFinancialAccounts OfficeFinancialAccount[]
  officeAccountTransfers  OfficeAccountTransfer[]
  automations             Automation[]
  // v1.37.0: Firma yetkilileri
  taxpayerYetkililer      TaxpayerYetkili[]

  @@map("tenants")
}

// ============================================================
// AUTH & RBAC
// ============================================================
model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // İki adımlı doğrulama (TOTP) — opsiyonel, varsayılan kapalı (mevcut giriş bozulmaz)
  totpSecret       String?  // base32 secret, crypto.ts ile şifreli saklanır
  totpEnabled      Boolean  @default(false)
  // Brute-force koruması — hesap bazlı (IP değil; ofis tek-IP'de cezalanmaz)
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  userRoles    UserRole[]
  auditLogs    AuditLog[]
  notifications Notification[]
  createdOfficeChatThreads OfficeChatThread[] @relation("OfficeChatThreadCreator")
  officeChatParticipants OfficeChatParticipant[]
  officeChatMessages OfficeChatMessage[]

  // v1.36.74 Faz 1: Gorevler & Hatirlatmalar iliskileri
  createdTasks       Task[]             @relation("TaskCreator")
  taskNotes          TaskNote[]
  taskAttachments    TaskAttachment[]
  pushSubscriptions  PushSubscription[]

  // Moren AI Otomasyon Motoru
  createdAutomations Automation[]       @relation("AutomationCreator")

  // Bildirim tercihleri (hangi tip notification'lari almak istemiyor)
  notificationPreference NotificationPreference?

  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique // ADMIN, STAFF, READONLY
  description String?
  permissions Json       @default("{}")
  createdAt   DateTime   @default(now())

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  assignedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  ipAddress   String?
  userAgent   String?

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  resource   String   // taxpayer, invoice, document, etc.
  resourceId String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ============================================================
// CRM - MÜKELLEFLEr
// ============================================================
model Taxpayer {
  id          String       @id @default(cuid())
  tenantId    String
  type        TaxpayerType // GERCEK_KISI | TUZEL_KISI
  firstName   String?
  lastName    String?
  companyName String?
  taxNumber   String       // VKN (10 hane) veya TCKN (11 hane) - şifreli
  taxOffice   String
  email       String?
  phone       String?
  phones      String[]     // 3 telefon numarası
  emails      String[]     // 3 e-posta adresi
  address     String?
  notes       String?
  startDate   DateTime?    // İşe başlama tarihi
  endDate     DateTime?    // İşi bırakma tarihi
  evrakTeslimGunu     Int?          // 1-30 arası, her ayın kaçında bekleniyor
  whatsappEvrakTalep  Boolean       @default(false)
  whatsappEvrakGeldi  Boolean       @default(false)
  lastReminderSentAt  DateTime?
  isActive    Boolean      @default(true)
  // E-Fatura mükellefi mi? (true → e-fatura/e-arşiv akışında dahil)
  isEFaturaMukellefi  Boolean      @default(false)
  // === OTOMASYON AJANLARI ===
  lucaSlug           String?  // Luca ZIP dosyasindaki slug ornegi "edeler_yem"
  mihsapId           String?  // Mihsap URL'indeki mukellef ID (/documents/BILANCO/1/110564)
  mihsapDefterTuru   String?  // "BILANCO" | "DEFTER_BEYAN"
  // Defter türü — Banka Takip modülü ve diğer modüller için genel alan.
  // "BILANCO" → Bilanço esasında tutuluyor (bankalar, cari, vs.)
  // "ISLETME" → İşletme defteri tutuluyor
  defterTuru         String?  // "BILANCO" | "ISLETME"
  hattatId           String?  // Hattat yazılımındaki iç mükellef kodu (ZIP import eşleştirme için)

  // === v1.37.0: Mükellef kartı genişletme (Hattat tarzı) ===
  logoUrl            String?  // Mükellef logosu (S3/MinIO URL)
  naceKodu           String?  // NACE faaliyet kodu (örn. "56.10.06")
  faaliyetAciklama   String?  // Serbest faaliyet/sektör açıklaması (ör. "yemek üretimi") — fatura hesap eşleştirmede öncelikli sinyal
  ticaretSicilNo    String?  // Ticaret sicil numarası
  mersisNo           String?  // MERSİS no (16 hane)
  odaSicilNo         String?  // Oda sicil no (İTO/ATO vb.)
  bagkurSicilNo     String?  // Bağ-Kur sicil no
  kepAdresi          String?  // Kayıtlı Elektronik Posta adresi
  webSitesi          String?  // Şirket web sitesi
  eFaturaEntegrator String?  // "UYUMSOFT" | "BILGENET" | "FORIBA" | "GIB_PORTAL" | diğer

  // === Mükellef self-servis portal girişi (opsiyonel; müşavir açar) ===
  portalEmail        String?    // portal giriş e-postası (yoksa `email` kullanılır)
  portalPasswordHash String?    // argon2id hash
  portalEnabled      Boolean    @default(false)
  portalLastLoginAt  DateTime?
  portalFailedLoginCount Int    @default(0)  // brute-force koruması
  portalLockedUntil  DateTime?               // bu ana kadar giriş kilitli

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  contacts            Contact[]
  communicationLogs   CommunicationLog[]
  tasksReminders      TaskReminder[]
  taxDeclarations     TaxDeclaration[]
  incomeExpenseRecords IncomeExpenseRecord[]
  invoices            Invoice[]
  employees           Employee[]
  documents           Document[]
  kdvControlSessions  KdvControlSession[]
  monthlyStatuses     TaxpayerMonthlyStatus[]
  vendorDecisions     VendorMemoryDecision[]
  beyanConfig         TaxpayerBeyanConfig?
  beyanDurumlari      BeyanDurumu[]
  beyanKayitlari      BeyanKaydi[]
  portalCredentials    PortalCredential[]
  portalAutomationJobs PortalAutomationJob[]
  portalDocuments      PortalDocument[]
  cariHizmetler       CariHizmet[]
  cariHareketler      CariHareket[]
  earsivFaturalar     EarsivFatura[]
  kdvLucaSnapshots    KdvLucaSnapshot[]
  isletmeHesapOzetleri IsletmeHesapOzeti[]
  bankaHesaplar       BankaHesap[]
  bankaEkstreKayitlari BankaEkstreKaydi[]
  // v1.36.74 Faz 1: Gorevler iliskisi
  tasks               Task[]
  // v1.37.0: Firma yetkilileri (Hattat tarzı mükellef kartı)
  yetkililer         TaxpayerYetkili[]

  @@index([tenantId])
  @@index([taxNumber])
  @@map("taxpayers")
}

// ============================================================
// FIRMA YETKILI BILGILERI (v1.37.0 — Hattat tarzı mükellef kartı)
// Şirket / mükellef adına yetkili kişiler:
// müdür, ortak, imza yetkilisi, muhasebe sorumlusu vb.
// ============================================================
model TaxpayerYetkili {
  id          String   @id @default(cuid())
  tenantId    String
  taxpayerId  String
  firstName   String
  lastName    String
  tcNo        String?  // T.C. Kimlik No (opsiyonel)
  gorev       String?  // "MUDUR" | "ORTAK" | "IMZA_YETKILI" | "MUHASEBE_SORUMLUSU" | serbest metin
  telefon     String?
  eposta      String?
  notes       String?
  isPrimary   Boolean  @default(false)  // Birincil iletişim kişisi mi
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxpayer    Taxpayer @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([taxpayerId])
  @@map("taxpayer_yetkililer")
}

// ============================================================
// MÜKELLEF BEYANNAME KONFIGURASYONU (Hattat-stil toplu beyanname takip)
// Her mükellef için hangi beyannameleri verir, dönemi ne.
// Ayarlar > Mükellef Beyanname Takip sayfasından düzenlenir.
// ============================================================
model TaxpayerBeyanConfig {
  id              String    @id @default(cuid())
  taxpayerId      String    @unique

  // Gelir/Kurumlar vergisi mükellef tipi (yıllık beyan için)
  incomeTaxType   String?   // "KURUMLAR" | "GELIR" | "BASIT_USUL" | null

  // KDV1 (Katma Değer Vergisi, 1 No'lu)
  kdv1Period      String?   // "AYLIK" | "UCAYLIK" | null (KDV mükellefi değilse)

  // KDV2 (Tevkifat) — aylık zorunlu, enabled bayrağı yeterli
  kdv2Enabled     Boolean   @default(false)

  // Muhtasar (MUHSGK — birleşik)
  muhtasarPeriod  String?   // "AYLIK" | "UCAYLIK" | null

  // Damga Vergisi (sürekli damga vergisi mükellefi mi)
  damgaEnabled    Boolean   @default(false)

  // Poşet Beyannamesi (3 aylık — plastik poşet kullananlar için)
  posetEnabled    Boolean   @default(false)

  // SGK Aylık Prim ve Hizmet Belgesi (çalışanı olanlar)
  sgkBildirgeEnabled Boolean @default(false)

  // E-Defter (bilanço usulü mükellefler için)
  eDefterPeriod   String?   // "AYLIK" | "UCAYLIK" | null (e-defter mükellefi değilse)

  // === v1.37.1: Hattat tarzı genişletilmiş beyanname türleri ===
  // KDV4 (özel kdv beyanları - e-ticaret, hizmet ihracatı vb.)
  kdv4Period           String?   // "AYLIK" | "UCAYLIK" | null
  // KDV9015 — Vergi tevkifatı (kıymetli maden, kira vb.)
  kdv9015Period        String?   // "AYLIK" | null
  // Gelir Geçici Vergi (GGECICI) — 3 aylık zorunlu
  gelirGeciciPeriod    String?   // "UCAYLIK" | null
  // Kurum Geçici Vergi (KGECICI) — 3 aylık zorunlu
  kurumGeciciPeriod    String?   // "UCAYLIK" | null
  // ÖTV türleri
  otv1Period           String?   // "AYLIK" | null (akaryakıt vb.)
  otv3aPeriod          String?   // "AYLIK" | null (motorlu taşıt)
  otv3bPeriod          String?   // "ON_BES_GUNLUK" | "AYLIK" | null (özel akaryakıt)
  otv4Period           String?   // "AYLIK" | null (alkollü içecek, tütün)
  // MUHSGK2 — 3 aylık muhtasar varyantı
  muhtasar2Period      String?   // "UCAYLIK" | null
  // Turizm Payı (3 aylık veya aylık)
  turizmPeriod         String?   // "AYLIK" | "UCAYLIK" | null
  // Konaklama Vergisi (aylık)
  konaklamaEnabled     Boolean   @default(false)
  // ÖİV — Özel İletişim Vergisi
  oivEnabled           Boolean   @default(false)
  // GMSİ — Gayrimenkul Sermaye İradı (yıllık)
  gmsiEnabled          Boolean   @default(false)

  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  taxpayer        Taxpayer  @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@map("taxpayer_beyan_configs")
}

// ============================================================
// DÖNEM BAZLI BEYAN DURUMU
// Her mükellef + dönem + beyan tipi için tek kayıt.
// Beyanname verildiğinde/onaylandığında güncellenir.
// Dashboard'daki Toplu Beyanname tablosu bu veriyi özetler.
// ============================================================
model BeyanDurumu {
  id              String    @id @default(cuid())
  tenantId        String
  taxpayerId      String
  beyanTipi       String    // "KURUMLAR" | "GELIR" | "KDV1" | "KDV2" | "DAMGA" | "MUHSGK" | "POSET" | "BILDIRGE" | "EDEFTER"
  donem           String    // "2026-03" format (yyyy-mm)
  durum           String    @default("beklemede")  // "beklemede" | "onaylandi" | "hatali" | "muaf"
  onayTarihi      DateTime?
  tahakkukTutari  Decimal?  @db.Decimal(14, 2)
  notlar          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  taxpayer        Taxpayer  @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, taxpayerId, beyanTipi, donem])
  @@index([tenantId, donem])
  @@index([tenantId, beyanTipi, donem])
  @@index([taxpayerId])
  @@map("beyan_durumlari")
}

// ============================================================
// BEYANNAME KAYITLARI (Hattat'tan import edilen geçmiş beyannameler)
// Her beyanname için tek kayıt: mükellef + tip + dönem + tutar + (ops.) PDF.
// Import kaynağı Hattat Excel export'u. Status alanı şimdilik yok —
// ileride durum takibi eklenecek (gönderildi/onaylandı vb.).
// ============================================================
model BeyanKaydi {
  id              String    @id @default(cuid())
  tenantId        String
  taxpayerId      String
  beyanTipi       String    // "KDV1" | "KDV2" | "MUHSGK" | "DAMGA" | "POSET" | "KURUMLAR" | "GELIR" | "BILDIRGE" | "EDEFTER" | "GGECICI" | "KGECICI" | "GECICI_VERGI" | "DIGER"
  donem           String    // "2026-03" format (yyyy-mm), yıllık beyanlar için "2025-YIL"
  beyanTarihi     DateTime? // Beyannamenin verildiği tarih
  tahakkukTutari  Decimal?  @db.Decimal(14, 2)
  odemeTutari     Decimal?  @db.Decimal(14, 2) // İleride ödeme takibi için
  onayNo          String?   // GİB onay numarası / tahakkuk no
  // Dosya referansları (opsiyonel)
  pdfUrl          String?   // Tahakkuk fişi PDF — storage key
  beyannameUrl    String?   // Beyanname aslı PDF — storage key
  xmlUrl          String?   // e-Beyanname XML — storage key
  // İçe aktarım izleme
  kaynak          String    @default("manuel") // "hattat_excel" | "gib_agent" | "manuel"
  importBatchId   String?   // Aynı anda import edilen grubu tanımlar
  notlar          String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  taxpayer        Taxpayer  @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  // Aynı mükellefin aynı dönem aynı tipinden 2 kayıt olmamalı
  @@unique([tenantId, taxpayerId, beyanTipi, donem])
  @@index([tenantId, donem])
  @@index([tenantId, beyanTipi])
  @@index([taxpayerId])
  @@index([importBatchId])
  @@map("beyan_kayitlari")
}

// ============================================================
// MÜKELLEF ↔ MOREN AI SOHBET KAYDI
// Mükellef portalı MOREN AI sohbeti kalıcı olsun (sayfa değişince gitmesin)
// + müşavir, mükellef detayından konuşmaları görebilsin.
// ============================================================
model TaxpayerChatMessage {
  id         String   @id @default(cuid())
  tenantId   String
  taxpayerId String
  role       String   // "user" | "assistant"
  text       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([taxpayerId, createdAt])
  @@index([tenantId, createdAt])
  @@map("taxpayer_chat_messages")
}

enum TaxpayerType {
  GERCEK_KISI
  TUZEL_KISI
}

model Contact {
  id         String   @id @default(cuid())
  taxpayerId String
  name       String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model CommunicationLog {
  id         String   @id @default(cuid())
  taxpayerId String
  channel    String   // EMAIL, PHONE, MEETING, OTHER
  subject    String
  content    String?
  occurredAt DateTime
  createdAt  DateTime @default(now())

  taxpayer   Taxpayer @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@index([taxpayerId])
  @@map("communication_logs")
}

model TaskReminder {
  id          String    @id @default(cuid())
  taxpayerId  String
  title       String
  description String?
  dueDate     DateTime
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  taxpayer    Taxpayer  @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@index([taxpayerId, dueDate])
  @@map("tasks_reminders")
}

// ============================================================
// BEYANNAME & VERGİ TAKVİMİ
// ============================================================
model TaxCalendar {
  id              String              @id @default(cuid())
  declarationType String              // DeclarationType enum value
  periodMonth     Int?                // 1-12
  periodYear      Int
  periodQuarter   Int?                // 1-4
  dueDate         DateTime
  description     String?
  createdAt       DateTime            @default(now())

  declarations    TaxDeclaration[]

  @@index([dueDate])
  @@map("tax_calendar")
}

model TaxDeclaration {
  id              String            @id @default(cuid())
  taxpayerId      String
  taxCalendarId   String
  declarationType String
  periodLabel     String            // "2025/03" gibi
  status          DeclarationStatus @default(PENDING)
  assignedUserId  String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  taxpayer          Taxpayer           @relation(fields: [taxpayerId], references: [id])
  taxCalendar       TaxCalendar        @relation(fields: [taxCalendarId], references: [id])
  submissionStatuses SubmissionStatus[]

  @@index([taxpayerId, declarationType])
  @@map("tax_declarations")
}

enum DeclarationStatus {
  PENDING
  PREPARING
  READY
  SUBMITTED
  ACCEPTED
  REJECTED
}

model SubmissionStatus {
  id              String         @id @default(cuid())
  declarationId   String
  status          DeclarationStatus
  referenceNumber String?
  notes           String?
  changedAt       DateTime       @default(now())

  declaration     TaxDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@index([declarationId])
  @@map("submission_statuses")
}

// ============================================================
// FATURA / GELİR-GİDER / RAPORLAMA
// ============================================================
model Invoice {
  id           String        @id @default(cuid())
  taxpayerId   String
  invoiceNo    String
  status       InvoiceStatus @default(DRAFT)
  type         InvoiceType   // SATIS | ALIS | ARSIV
  issueDate    DateTime
  dueDate      DateTime?
  subtotal     Decimal       @db.Decimal(15, 2)
  vatAmount    Decimal       @db.Decimal(15, 2)
  totalAmount  Decimal       @db.Decimal(15, 2)
  currency     String        @default("TRY")
  notes        String?
  ublXml       String?       // UBL-TR XML içeriği (e-Fatura)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  taxpayer     Taxpayer      @relation(fields: [taxpayerId], references: [id])
  lines        InvoiceLine[]

  @@index([taxpayerId, status])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum InvoiceType {
  SATIS
  ALIS
  ARSIV
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @db.Decimal(15, 4)
  unitPrice   Decimal  @db.Decimal(15, 4)
  vatRate     Decimal  @db.Decimal(5, 4) // 0.20, 0.10, 0.01, 0.00
  lineTotal   Decimal  @db.Decimal(15, 2)
  vatAmount   Decimal  @db.Decimal(15, 2)
  sortOrder   Int      @default(0)

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_lines")
}

model IncomeExpenseRecord {
  id           String      @id @default(cuid())
  taxpayerId   String
  type         RecordType  // INCOME | EXPENSE
  category     String
  description  String?
  amount       Decimal     @db.Decimal(15, 2)
  vatAmount    Decimal     @db.Decimal(15, 2) @default(0)
  currency     String      @default("TRY")
  recordDate   DateTime
  invoiceId    String?
  createdAt    DateTime    @default(now())

  taxpayer     Taxpayer    @relation(fields: [taxpayerId], references: [id])

  @@index([taxpayerId, recordDate])
  @@map("income_expense_records")
}

enum RecordType {
  INCOME
  EXPENSE
}

model ReportSnapshot {
  id         String   @id @default(cuid())
  tenantId   String
  taxpayerId String?
  reportType String   // MONTHLY_INCOME, YEARLY_SUMMARY, etc.
  periodLabel String  // "2025/03"
  data       Json
  createdAt  DateTime @default(now())

  @@index([tenantId, reportType, periodLabel])
  @@map("report_snapshots")
}

// ============================================================
// BORDRO & SGK
// ============================================================
model Employee {
  id           String    @id @default(cuid())
  taxpayerId   String
  firstName    String
  lastName     String
  tcNo         String    // TCKN - şifreli
  startDate    DateTime
  endDate      DateTime?
  jobTitle     String?
