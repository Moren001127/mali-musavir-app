  previewId        String   @unique
  userId           String?
  ownerPhone       String?
  aiConversationId String?
  agent            String
  action           String
  payload          Json
  impact           String?  @db.Text
  status           String   @default("PENDING") // PENDING | EXECUTED | EXPIRED | REJECTED
  expiresAt        DateTime
