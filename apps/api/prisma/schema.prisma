// Owner'ın portalda kendi tanımladığı mesaj şablonları (WhatsApp + e-posta).
// Toplu/otomatik gönderim bunları okur; body içinde {ad} {tutar} {vade} ... placeholder'ları.
model MessageTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  ad           String
  kanal        String   @default("BOTH")    // WHATSAPP | EMAIL | BOTH
  kategori     String   @default("genel")   // evrak | beyanname | sgk | odeme | tebligat | ekstre | genel
  emailSubject String?
  body         String
  attachPdf    Boolean  @default(false)
  auto         Boolean  @default(false)
  autoEvent    String?
  sirano       Int      @default(0)
  isActive     Boolean  @default(true)
  favori         Boolean  @default(false)  // sık kullanılan — galeride sabitlenir
  kullanimSayisi Int      @default(0)      // toplam gönderim sayısı (test + gerçek)
  sonKullanim    DateTime?                 // en son ne zaman gönderildi
