model Arac {
  id          String   @id @default(cuid())
  tenantId    String
  plaka       String   // "34 ABC 123" veya "34ABC123" — normalize edilir
  marka       String?  // Opsiyonel: araç markası
  model       String?  // Opsiyonel: araç modeli
  sahipAd     String?  // Opsiyonel: araç sahibi (galerici müşteri vb.)
  taxpayerId  String?  // Opsiyonel: portaldaki mükellefe bağlama
  aktif       Boolean  @default(true)
  notlar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hgsSonuclari HgsIhlalSorguSonucu[]

  @@unique([tenantId, plaka])
  @@index([tenantId])
  @@index([taxpayerId])
  @@map("araclar")
}

// Her sorgu bir kayıt — aynı plaka için dönem dönem birden fazla kayıt olur
model HgsIhlalSorguSonucu {
  id           String   @id @default(cuid())
  tenantId     String
  aracId       String
  sorguTarihi  DateTime @default(now())
  durum        String   @default("beklemede") // "beklemede" | "basarili" | "hatali"
  ihlalSayisi  Int      @default(0)
  toplamTutar  Decimal? @db.Decimal(14, 2)
  detaylar     Json?    // Ham ihlal detayları (tarih, tutar, ücret noktası vb. array)
  rawHtml      String?  @db.Text // Sorgu HTML snapshoti (debug için)
  hataMesaji   String?  // durum=hatali ise sebep
  kaynak       String   @default("manuel") // "manuel" | "cron_pazartesi" | "tek_sefer"

  arac         Arac     @relation(fields: [aracId], references: [id], onDelete: Cascade)

  @@index([tenantId, sorguTarihi])
  @@index([aracId, sorguTarihi])
  @@map("hgs_ihlal_sorgu_sonuclari")
}

// ============================================================
// CARİ KASA — Müşteri Hizmetleri ve Ödeme Takibi
// ============================================================

// Mükellefe tanımlanan tekrar eden hizmetler (muhasebe ücreti, bordro, SGK, vb.)
// Her ayın 1. günü cron otomatik tahakkuk kaydı oluşturur.
model CariHizmet {
  id            String    @id @default(cuid())
  tenantId      String
  taxpayerId    String
  hizmetAdi     String    // "Muhasebe Ücreti", "Bordro", "SGK", "Yıllık Kapanış", vb.
  tutar         Decimal   @db.Decimal(14, 2)
  periyot       String    // "AYLIK" | "UCAYLIK" | "ALTIAYLIK" | "YILLIK"
  baslangicAy   String    // "2026-01" formatı — bu aydan itibaren tahakkuk geçer
  bitisAy       String?   // opsiyonel, belirtilirse o aya kadar tahakkuk edilir
  aktif         Boolean   @default(true)
  sonTahakkukAy String?   // "2026-04" — duplicate önleme (cron kontrolü)
  notlar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  taxpayer      Taxpayer       @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  hareketler    CariHareket[]

  @@index([tenantId, taxpayerId])
  @@index([tenantId, aktif])
  @@map("cari_hizmetler")
}

// Cari hareketler — tahakkuk (borç) ve tahsilat (alacak) kayıtları.
// Bakiye = SUM(TAHAKKUK) - SUM(TAHSILAT) olarak hesaplanır.
model CariHareket {
  id             String    @id @default(cuid())
  tenantId       String
  taxpayerId     String
  accountId      String?   // Tahsilat hangi banka/kasa hesabına girdi
  hizmetId       String?   // Tahakkuksa hizmete bağlı; manuel ödeme ise null
  tarih          DateTime
  tip            String    // "TAHAKKUK" | "TAHSILAT" | "IADE" | "DUZELTME"
  tutar          Decimal   @db.Decimal(14, 2)
  aciklama       String?
  odemeYontemi   String?   // "NAKIT" | "HAVALE" | "POS" | "CEK" | "SENET" | null
  belgeNo        String?   // Dekont/makbuz no
  donem          String?   // "2026-04" — tahakkuk hangi ayın, tahsilat hangi aya ait
  otoOlusturuldu Boolean   @default(false)
  source         String?
  sourceRef      String?
  importBatchId  String?
  createdAt      DateTime  @default(now())
  createdBy      String?

  taxpayer       Taxpayer     @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  hizmet         CariHizmet?  @relation(fields: [hizmetId], references: [id], onDelete: SetNull)
  account        OfficeFinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([tenantId, taxpayerId, tarih])
  @@index([tenantId, tarih])
  @@index([tenantId, tip])
  @@index([tenantId, accountId])
  @@index([tenantId, source])
  @@map("cari_hareketler")
}

model OfficeFinancialAccount {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  type           String   // "BANKA" | "NAKIT" | "KREDI_KARTI" | "DIGER"
  color          String   @default("#d4b876")
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  openingDate    DateTime @default(now())
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetEntries  OfficeBudgetEntry[]
  cariHareketler CariHareket[]
  transfersFrom  OfficeAccountTransfer[] @relation("TransferFromAccount")
  transfersTo    OfficeAccountTransfer[] @relation("TransferToAccount")

  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("office_financial_accounts")
}

model OfficeAccountTransfer {
  id            String   @id @default(cuid())
  tenantId      String
  fromAccountId String
  toAccountId   String
  date          DateTime
  period        String   // "2026-05"
  amount        Decimal  @db.Decimal(14, 2)
  description   String?
  documentNo    String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromAccount   OfficeFinancialAccount @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     OfficeFinancialAccount @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId, period])
  @@index([fromAccountId, date])
  @@index([toAccountId, date])
  @@map("office_account_transfers")
}

// Ofis ici gelir/gider butce takibi.
model OfficeBudgetCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  type      String   // "GELIR" | "GIDER"
  color     String   @default("#d4b876")
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries   OfficeBudgetEntry[]
  plans     OfficeBudgetPlan[]

  @@unique([tenantId, name, type])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@map("office_budget_categories")
}

model OfficeBudgetEntry {
  id            String   @id @default(cuid())
  tenantId      String
  categoryId    String
  accountId     String?
  date          DateTime
  period        String   // "2026-05"
  type          String   // "GELIR" | "GIDER"
  amount        Decimal  @db.Decimal(14, 2)
  description   String?
  paymentMethod String?
  documentNo    String?
  source        String   @default("MANUAL")
  isRecurring   Boolean  @default(false)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      OfficeBudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account       OfficeFinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([tenantId, period])
  @@index([tenantId, type])
  @@index([tenantId, accountId])
  @@index([categoryId, date])
  @@map("office_budget_entries")
}

model OfficeBudgetPlan {
  id            String   @id @default(cuid())
  tenantId      String
  categoryId    String
  period        String   // "2026-05"
  plannedAmount Decimal  @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      OfficeBudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([tenantId, categoryId, period])
  @@index([tenantId, period])
  @@index([categoryId, period])
  @@map("office_budget_plans")
}

// === E-ARŞİV / E-FATURA ===
// Luca'dan toplu çekilen e-arşiv (SATIŞ) ve e-fatura (ALIŞ) faturaları.
// Orijinal UBL XML + PDF saklanır (denetim için), parse edilen alanlar ayrı kolonlarda.
model EarsivFatura {
  id             String     @id @default(cuid())
  tenantId       String
  taxpayerId     String
  tip            EarsivTip  // SATIS | ALIS
  belgeKaynak    BelgeKaynak @default(EARSIV) // EFATURA | EARSIV — Luca'da iki ayrı tab
  donem          String     // "2026-03" YYYY-MM
  faturaNo       String
  faturaTarihi   DateTime
  ettn           String?    // E-fatura/e-arşiv UUID
  satici         String?
  saticiVergiNo  String?
  alici          String?
  aliciVergiNo   String?
  matrah         Decimal?   @db.Decimal(18, 2)
  kdvTutari      Decimal?   @db.Decimal(18, 2)
  kdvOrani       Decimal?   @db.Decimal(5, 2)
  toplamTutar    Decimal?   @db.Decimal(18, 2)
  paraBirimi     String?    @default("TL")
  // Çoklu KDV oranı desteği — UBL TaxSubtotal'lardan parse edilir.
  // Şekil: [{ rate: 20, base: 1000.00, amount: 200.00 }, { rate: 1, base: 500, amount: 5 }]
  // matrah/kdvTutari/kdvOrani alanları geriye uyumluluk için tutulur (toplamlar).
  kdvBreakdown   Json?
  aciklama       String?
  durum          String?    // KABUL | RED | IPTAL | BEKLEMEDE
  xmlContent     String?    @db.Text  // orijinal UBL XML
  pdfStorageKey  String?    // S3 key veya disk path; ham PDF
  htmlStorageKey String?    // S3 key; Luca'nin verdigi orijinal HTML gorunum
  zipSourceName  String?    // Hangi ZIP'ten geldi
  fetchJobId     String?    // Hangi LucaFetchJob ile çekildi
  // Mihsap upload tracking — gelen e-arşiv faturasını gider faturası olarak Mihsap'a yükleme
  mihsapUploadedAt    DateTime?  // başarıyla yüklendi
  mihsapUploadStatus  String?    // pending | uploaded | failed
  mihsapUploadError   String?    // hata mesajı (varsa)
  mihsapUploadJobId   String?    // takip için job referansı
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  taxpayer       Taxpayer   @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, taxpayerId, tip, belgeKaynak, faturaNo])
  @@index([tenantId, taxpayerId, donem, tip, belgeKaynak])
  @@index([tenantId, faturaTarihi])
  @@index([fetchJobId])
  @@index([mihsapUploadStatus])
  @@map("earsiv_faturalar")
}

enum EarsivTip {
  SATIS
  ALIS
}

enum BelgeKaynak {
  EFATURA  // E-fatura mükellefleri arası gelen/giden
  EARSIV   // E-arşiv (kamuya, e-fatura mükellefi olmayan müşteri)
}

// ─────────────────────────────────────────────────────────────
// KDV BEYANNAME — LUCA MİZAN SNAPSHOT
// ─────────────────────────────────────────────────────────────
// KDV beyannamesi çapraz kontrolü için Luca'dan AYRICA çekilen aylık mizan.
// Mizan modülünden BAĞIMSIZ — geçici vergi mizanı KDV beyanını ilgilendirmez.
// hamMizan Json'da TÜM hesap satırları durur; UI'da sadece 190/191/391 + 600/770
// gibi KDV-ilgili olanlar gösterilir.
model KdvLucaSnapshot {
  id            String   @id @default(cuid())
  tenantId      String
  taxpayerId    String
  donem         String   // "2026-03"
  cekildiAt     DateTime @default(now())
  cekenUserId   String?
  fetchJobId    String?  // Hangi LucaFetchJob ile çekildi
  hamMizan      Json     // Tüm mizan satırları: [{ kod, ad, borcToplami, alacakToplami, borcBakiye, alacakBakiye }]
  toplamHesapAdet Int    @default(0)

  taxpayer      Taxpayer @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, taxpayerId, donem])
  @@index([tenantId, taxpayerId, cekildiAt])
  @@map("kdv_luca_snapshots")
}

// ─────────────────────────────────────────────────────────────
// İŞLETME HESAP ÖZETİ — Çeyreklik karşılaştırmalı (TAMAMI MANUEL)
// ─────────────────────────────────────────────────────────────
// İşletme defteri tutan (2.sınıf tüccar, basit usul) mükellefler için.
// Q1-Q4 çeyrek bazlı kayıt; her dönem için stok hareketi + geçici vergi matrahı.
// HİÇBİR ALAN OTOMATİK ÇEKİLMEZ — kullanıcı tüm tutarları el ile girer.
//
// Tek otomatik bağ: Q2-Q4 dönem başı stoğu, önceki çeyreğin kalan stoğunu kullanır.
//
// Türetilen alanlar:
//   - toplamStok          = donemBasiStok + malAlisi
//   - satilanMalMaliyeti  = toplamStok - kalanStok
//   - netSatislar         = (satisHasilati + digerGelir) - satilanMalMaliyeti
//   - donemKari           = netSatislar - donemIciGiderler
//   - gecVergiMatrahi     = max(0, donemKari - gecmisYilZarari)
//   - hesaplananGecVergi  = gecVergiMatrahi * 0.15  (işletme için %15)
//   - odenecekGecVergi    = max(0, hesaplananGecVergi - oncekiOdenenGecVergi)
model IsletmeHesapOzeti {
  id              String    @id @default(cuid())
  tenantId        String
  taxpayerId      String
  yil             Int
  donem           Int

  satisHasilati   Decimal   @db.Decimal(15, 2) @default(0)
  digerGelir      Decimal   @db.Decimal(15, 2) @default(0)

  malAlisi        Decimal   @db.Decimal(15, 2) @default(0)
  donemBasiStok   Decimal   @db.Decimal(15, 2) @default(0)
  kalanStok       Decimal   @db.Decimal(15, 2) @default(0)
  toplamStok      Decimal   @db.Decimal(15, 2) @default(0)
  satilanMalMaliyeti Decimal @db.Decimal(15, 2) @default(0)
  netSatislar     Decimal   @db.Decimal(15, 2) @default(0)

  donemIciGiderler Decimal  @db.Decimal(15, 2) @default(0)

  donemKari       Decimal   @db.Decimal(15, 2) @default(0)

  gecmisYilZarari Decimal   @db.Decimal(15, 2) @default(0)
  gecVergiMatrahi Decimal   @db.Decimal(15, 2) @default(0)
  hesaplananGecVergi Decimal @db.Decimal(15, 2) @default(0)
  oncekiOdenenGecVergi Decimal @db.Decimal(15, 2) @default(0)
  odenecekGecVergi Decimal  @db.Decimal(15, 2) @default(0)

  not             String?

  locked          Boolean   @default(false)
  lockedAt        DateTime?
  lockedBy        String?
  lockNote        String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?

  taxpayer        Taxpayer  @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, taxpayerId, yil, donem])
  @@index([tenantId, yil])
  @@index([taxpayerId, yil, donem])
  @@map("isletme_hesap_ozetleri")
}

// ============================================================
// BANKA HESAPLARI — Bilanço mükelleflerinin banka hesap bilgileri
// Mükellef başına birden fazla hesap (Ziraat, İş Bankası, Garanti vb.)
// ============================================================
model BankaHesap {
  id          String    @id @default(cuid())
  tenantId    String
  taxpayerId  String
  bankaAdi    String    // "Ziraat Bankası", "İş Bankası", "Garanti BBVA" vb.
  hesapNo     String?   // hesap numarası (opsiyonel - IBAN yeterli olabilir)
  iban        String?
  sube        String?
  paraBirimi  String    @default("TRY") // TRY, USD, EUR
  aciklama    String?   // "Ana hesap", "Maaş hesabı" gibi notlar
  aktif       Boolean   @default(true)
  sira        Int       @default(0) // gösterim sırası
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  taxpayer    Taxpayer  @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  ekstreler   BankaEkstreKaydi[]

  @@index([tenantId])
  @@index([taxpayerId])
  @@map("banka_hesaplari")
}

// ============================================================
// BANKA EKSTRE KAYITLARI — Aylık ekstre takip
// Hem mükellef başına (genel ekstre durumu) hem hesap-bazında detay
// ============================================================
model BankaEkstreKaydi {
  id              String    @id @default(cuid())
  tenantId        String
  taxpayerId      String
  bankaHesapId    String?   // null ise mükellef-genel ekstre durumu (tüm hesaplar birlikte)
  donem           String    // "YYYY-MM" — örn "2026-04"
  // Ekstre geldi mi? (ne zaman alındığı bilgisi varsa geldiTarihi)
  ekstreGeldi     Boolean   @default(false)
  geldiTarihi     DateTime?
  // Ekstre işlendi mi? (cari kasaya/muhasebeye işlendi mi?)
  ekstreIslendi   Boolean   @default(false)
  islenmeTarihi   DateTime?
  islenmeNotu     String?   // "31.12 itibariyle hareketler işlendi" vb.
  notlar          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  taxpayer        Taxpayer    @relation(fields: [taxpayerId], references: [id], onDelete: Cascade)
  bankaHesap      BankaHesap? @relation(fields: [bankaHesapId], references: [id], onDelete: SetNull)

  @@unique([tenantId, taxpayerId, bankaHesapId, donem])
  @@index([tenantId, donem])
  @@index([taxpayerId, donem])
  @@map("banka_ekstre_kayitlari")
}


// ============================================================
// SISTEM SAGLIK KONTROLU (System Health Watchdog)
// Backend cron service her 5 dk'da bir kritik bilesenleri kontrol eder
// ve sonuclari buraya yazar. Frontend top-bar dashboard bell butonu
// /system/health endpoint'inden bunlari okur.
// ============================================================
model SystemHealthCheck {
  id          String   @id @default(cuid())
  tenantId    String?  // null = tum tenantlari etkileyen sistem-genel kontrol
  type        String   // "AGENT_PING_MIHSAP", "AGENT_PING_LUCA", "LUCA_TOKEN_AGE",
                       // "MIHSAP_TOKEN_AGE", "PENDING_QUEUE", "FAILED_RATIO",
                       // "MODULE_HASH", "AGENT_VERSION", "DB_HEALTH"
  severity    String   // "OK" | "WARNING" | "CRITICAL"
  status      String   // "HEALTHY" | "DEGRADED" | "DOWN"
  message     String   // kullaniciya gosterilecek aciklama
  detail      Json?    // metric: pendingCount, lastPingAge, hash, etc.
  acilTavsiye String?  // "Bookmarklet'i kapat-ac" gibi action
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, severity, resolved])
  @@index([type, createdAt])
  @@map("system_health_checks")
}

// ============================================================
// KILITLI MODUL — admin'in panelden yonettigi modul kilit listesi.
// SystemHealth her 5 dk dosyalarin hash'ini hesaplar, DB ile karsilastirir,
// uyumsuzlukta MODULE_HASH alarmi atar.
// .locked-modules.json sadece SEED kaynagi — DB master.
// ============================================================
model LockedModule {
  id          String   @id @default(cuid())
  path        String   @unique // "apps/web/src/.../page.tsx" gibi repo-relative path
  sha256      String   // beklenen baseline hash (re-baseline yapilirsa guncellenir)
  reason      String   // kilitlenme sebebi: "tam otomasyon, dokunma" gibi
  lockedBy    String   // userId (kilitleyen admin)
  lockedAt    DateTime @default(now())
  rebaselined Int      @default(0) // kac kez baseline guncellendi
  notes       String?  // ek not
  active      Boolean  @default(true) // false = unlock (audit icin satir kalir)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@map("locked_modules")
}

// ============================================================
// GOREVLER & HATIRLATMALAR (v1.36.74 Faz 1)
// Mali musavirlik is akisi icin merkezi gorev sistemi.
// - Tek seferlik veya tekrarli (gunluk/haftalik/aylik/yillik)
// - Mukellef bagi opsiyonel
// - Cok kanalli bildirim: in-app, email (Google Workspace SMTP), browser push
// - Eskalasyon: vade gectikce uyarilar siklasir
// ============================================================
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  SNOOZED
  MISSED
  CANCELLED
}

model Task {
  id              String       @id @default(cuid())
  tenantId        String

  // Icerik
  title           String
  description     String?      @db.Text
  category        String?      // BEYANNAME, BORDRO, MIHSAP, OFIS, MUKELLEF, vb.
  priority        TaskPriority @default(MEDIUM)
  color           String?      // hex (UI icin)
  tags            String[]     @default([])

  // Mukellef bagi (opsiyonel)
  taxpayerId      String?
  taxpayer        Taxpayer?    @relation(fields: [taxpayerId], references: [id], onDelete: SetNull)

  // Atayan
  createdById     String
  createdBy       User         @relation("TaskCreator", fields: [createdById], references: [id])

  // Zaman
  dueDate         DateTime?
  dueTime         String?      // "09:00" formati (HH:mm), null ise tum gun
  allDay          Boolean      @default(true)

  // Tekrar
  recurrence      Json?        // RecurrenceConfig (TS interface)
  parentTaskId    String?
  parent          Task?        @relation("TaskRecurrence", fields: [parentTaskId], references: [id], onDelete: Cascade)
  children        Task[]       @relation("TaskRecurrence")
  isTemplate      Boolean      @default(false) // Tekrar sablonu mu, gercek instance mi
  nextOccurrence  DateTime?    // Bir sonraki olusturulacak tekrar tarihi

  // Hatirlatma stratejisi
  reminderConfig  Json?        // RemindConfig (TS interface)

  // Bildirim kanallari
  notifyInApp     Boolean      @default(true)
  notifyEmail     Boolean      @default(false)
  notifyBrowser   Boolean      @default(true)
  notifySound     Boolean      @default(false)

  // Durum
  status          TaskStatus   @default(OPEN)
  completedAt     DateTime?
  completedById   String?
  snoozedUntil    DateTime?

  // Eskalasyon
  escalationLevel Int          @default(0) // 0..5 arasi (5=mali musavire mail gitti)
  lastReminderAt  DateTime?

  // Audit
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Iliskiler
  notes           TaskNote[]
  attachments     TaskAttachment[]
  reminderLogs    TaskReminderLog[]

  @@index([tenantId, status, dueDate])
  @@index([tenantId, taxpayerId])
  @@index([tenantId, parentTaskId])
  @@index([tenantId, isTemplate])
  @@index([nextOccurrence])
  @@map("tasks")
}

model TaskNote {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_notes")
}

model TaskAttachment {
  id            String   @id @default(cuid())
  taskId        String
  filename      String
  s3Key         String
  size          Int
  mimeType      String?
  uploadedById  String
  createdAt     DateTime @default(now())

  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("task_attachments")
}

model TaskReminderLog {
  id           String    @id @default(cuid())
  taskId       String
  scheduledFor DateTime
  sentAt       DateTime?
  channel      String    // IN_APP | EMAIL | PUSH | SOUND
  status       String    // PENDING | SENT | FAILED | SKIPPED
  recipientId  String?
  errorMsg     String?
  createdAt    DateTime  @default(now())

  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([scheduledFor, status])
  @@map("task_reminder_logs")
}

// Browser Push abonelikleri (her cihaz/tarayici icin)
model PushSubscription {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  endpoint     String   @unique // Browser push service URL
  p256dh       String   // Public key
  auth         String   // Auth secret
  userAgent    String?  // Hangi tarayici/OS
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

// ============================================================
// FAZ 2 — MERKEZİ ONAY KUYRUĞU (PendingAction)
// ============================================================
// Her AI ekibi (Moren Ofis, Portal Geliştirme, mobil, mükellef mesaj)
// write/dışa-iletim eylemleri için BU tabloyu kullanır. Tek kuyruk, tek UI,
// tek audit. Kullanıcı /panel/onay-kuyrugu sayfasından görür, onaylar/reddeder.
//
// Karar matrisi (09-REVIZE):
//   - Veri okuma → otomatik (PendingAction GİRMEZ)
//   - DB yazımı, mesaj gönderme, GitHub merge, migration → PendingAction
//
// payload: gerçek diff/değişiklik JSON (uygulanırken işlenir)
// source: hangi sistemden geldi (filter için)
// status: pending → approved | rejected | expired → applied (worker)
// ------------------------------------------------------------
model PendingAction {
  id                String    @id @default(cuid())
  tenantId          String
  source            String    // moren_ofis | portal_dev | mukellef_msg | github_merge | migration | mobile
  sourceRef         String?   // kaynak id (conversation, task, pr no, ...)
  type              String    // create | update | delete | send_message | merge_pr | run_migration | deploy
  title             String
  summary           String    @db.Text
  payload           Json      // uygulamada parse edilecek değişiklik verisi
  riskLevel         String    @default("low") // low | medium | high | critical
  requestedByAgent  String?   // ajan adı (arda, nevra, ..., seda, eren)
  requestedByUserId String?   // kullanıcı tetiklediyse user id
  requestedAt       DateTime  @default(now())
  status            String    @default("pending") // pending | approved | rejected | expired | applied | failed
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewNote        String?   @db.Text
  appliedAt         DateTime?
  errorMessage      String?   @db.Text
  expiresAt         DateTime?

  @@index([tenantId, status])
  @@index([source, sourceRef])
  @@index([requestedAt])
  @@map("pending_actions")
}

// ============================================================
// FAZ 4 — PORTAL GELİŞTİRME EKİBİ (5 AJAN — EREN/MELİS/SEDA/OKAN/BERK)
// ============================================================
// Bu ekip kod YAZMAZ — sadece PR planı/diff önerisi üretir.
// Asıl implementasyon Verdent (veya kullanıcı) tarafından yapılır.
// Karar: 09-REVIZE'de tartışıldı, Faz 5 (gerçek kod yazımı) ertelendi.
//
// Görev döngüsü: backlog → in_progress → in_review → done
// Plan onaylanırsa PendingAction'a düşer, kullanıcı "Verdent'e ver" butonuyla
// kapanır (ya da kendi elinden uygular).
// ------------------------------------------------------------
model PortalDevTask {
  id                String   @id @default(cuid())
  tenantId          String
  title             String
  description       String   @db.Text
  status            String   @default("backlog") // backlog | in_progress | in_review | done | cancelled
  priority          String   @default("medium")  // high | medium | low
  type              String   @default("feature") // feature | bug | refactor | doc | infra
  riskLevel         String   @default("medium")  // low | medium | high | critical
  assignee          String?                      // eren|melis|seda|okan|berk
  createdByUserId   String
  acceptance        String?  @db.Text             // kabul kriteri
  // PR planı çıktıları — SEDA üretir
  proposedFiles     String[] @default([])         // değişecek dosya listesi
  proposedDiff      String?  @db.Text             // markdown ile diff/yapılacaklar
  estimateHrs       Float?
  sourceProposalId  String?  // DENİZ proposal'ı tetiklediyse link
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages          PortalDevMessage[]

  @@index([tenantId, status])
  @@index([assignee, status])
  @@map("portal_dev_tasks")
}

model PortalDevMessage {
  id              String   @id @default(cuid())
  tenantId        String
  taskId          String?
  agent           String   // eren|melis|seda|okan|berk|user
  userId          String?
  content         String   @db.Text
  ts              DateTime @default(now())

  task            PortalDevTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([tenantId, taskId])
  @@map("portal_dev_messages")
}

// ============================================================
// TOOL CALL LOG (audit — Faz 3'te promise edildi)
// ============================================================
// Her tool çağrısının kalıcı denetim kaydı. Mesaj JSON'una gömülü olan
// toolCalls alanı sadece UI rozet için; gerçek denetim, maliyet analizi
// ve kaçak yakalama bu tablo üzerinden yapılır.
// ------------------------------------------------------------
model ToolCallLog {
  id          String   @id @default(cuid())
  tenantId    String
  caller      String   // moren_ofis | moren_ai | portal_dev | patrol
  callerRef   String?  // conversation id / task id / agent name
  agent       String?  // arda|nevra|cem|... (kim çağırdı)
  tool        String   // list_taxpayers, get_kdv_summary, ...
  input       Json
  ok          Boolean
  durationMs  Int
  resultSize  Int?     // dönen JSON byte boyutu (yaklaşık)
  errorMsg    String?
  ts          DateTime @default(now())

  @@index([tenantId, ts])
  @@index([tenantId, tool])
  @@index([tenantId, caller, callerRef])
  @@map("tool_call_logs")
}

// ============================================================
// MOREN AI OTOMASYON MOTORU (Faz 1)
// ------------------------------------------------------------
// Kullanıcının doğal dilde tanımladığı, AI tarafından workflow JSON'a
// çevrilen ve arka planda çalışan otomasyonlar. Detay için:
// MOREN_AI_OTOMASYON_MOTORU_PLAN.md
// ============================================================
model Automation {
  id          String   @id @default(cuid())
  tenantId    String
  createdById String

  // Kullanıcının yazdığı orijinal cümle (örn. "Her ayın 22'sinde KDV gecikenlere WhatsApp at")
  prompt      String   @db.Text

  // Moren AI'nın cümleden çıkardığı insan-okur özet
  title       String
  description String?  @db.Text

  // Tetikleyici
  triggerType   AutomationTriggerType
  triggerConfig Json    // { cron: "0 10 22 * *" } | { eventName: "WhatsApp.MessageReceived", filters: {...} } | { secret: "..." }

  // Aksiyon adımları — sıralı liste (workflow JSON)
  // Şema versiyonlu: { schemaVersion: 1, steps: [...] }
  steps       Json

  // Durum yönetimi
  status        AutomationStatus  @default(DRAFT)
  lastRunAt     DateTime?
  lastRunStatus String?           // "success" | "failure" | "partial"
  nextRunAt     DateTime?
  totalRuns     Int               @default(0)
  successRuns   Int               @default(0)
  failureRuns   Int               @default(0)

  // Hata politikası: "notify" | "pause_after_3" | "ignore"
  failurePolicy String   @default("notify")

  // Tahmini run başına Claude maliyeti (USD, kurulurken hesaplanır)
  estimatedCostPerRun Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdBy   User     @relation("AutomationCreator", fields: [createdById], references: [id])
  runs        AutomationRun[]

  @@index([tenantId, status])
  @@index([tenantId, triggerType])
  @@index([nextRunAt])
  @@map("automations")
}

enum AutomationTriggerType {
  CRON
  EVENT
  WEBHOOK
  MANUAL
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
  ARCHIVED
}

model AutomationRun {
  id           String   @id @default(cuid())
  automationId String

  startedAt    DateTime @default(now())
  finishedAt   DateTime?

  // "running" | "success" | "failure" | "partial"
  status       String   @default("running")

  // Tetikleyici payload'ı (event verisi, webhook body, manuel input)
  triggerPayload Json?

  // Adım adım yürütme logu
  // [{ stepId: "step_1", tool: "...", input: {...}, output: {...}, error: null, ms: 1240 }, ...]
  stepLogs     Json     @default("[]")

  // Kullanıcının liste sayfasında göreceği kısa özet (örn. "12 mükellefe mesaj atıldı, 0 hata")
  summary      String?  @db.Text
  errorMessage String?  @db.Text

  // Bu run'da harcanan Claude maliyeti (USD)
  costUsd      Float?

  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, startedAt])
  @@index([status, startedAt])
  @@map("automation_runs")
}

// ============================================================
// EFATURA INBOX — Entegratörden çekilen ham faturalar
// Her entegratör adaptörü faturayı buraya yazar.
// @@unique([entegrator, uuid]) ile aynı fatura iki kez giremez.
// ============================================================
model EFaturaInbox {
  id            String    @id @default(cuid())
  tenantId      String
  taxpayerId    String
  entegrator    String    // "NILVERA" | "IZIBIZ" | "UYUMSOFT" | "TURKCELL" | "EDM" | "FORIBA" | "PARASUT" | "ELOGO" | "GIB_PORTAL"
  uuid          String
  ettn          String?
  senderVkn     String?
  senderTitle   String?
  receiverVkn   String?
  faturaNo      String?
  faturaDate    DateTime?
  matrah        Decimal?  @db.Decimal(14, 2)
  kdv           Decimal?  @db.Decimal(14, 2)
  toplam        Decimal?  @db.Decimal(14, 2)
  paraBirimi    String    @default("TRY")
  direction     String    @default("IN")   // IN | OUT
  invoiceProfile String?  // TEMELFATURA | TICARIFATURA | IHRACAT vb.
  ublXmlKey     String?   // S3 storage key — UBL-TR XML
  ublXmlRaw     String?   @db.Text  // Küçük XML'leri doğrudan saklama seçeneği (<50KB)
  rawJson       Json?     // Entegratörden gelen özet metadata
  isTransferred Boolean   @default(false)  // accounting modülüne aktarıldı mı
  documentId    String?   // InvoiceAccountingDocument.id ile ilişki (işlendikten sonra)
  syncedAt      DateTime  @default(now())
  markedAt      DateTime? // Entegratöre "aktarıldı" bayrağı atıldığı an
  processedAt   DateTime? // Muhasebe modülüne aktarıldığı an

  // Mükellef izolasyonu: aynı UUID birden çok mükellef/tenant'ta çekilebilir
  // (aynı entegratör hesabı çok mükellefe hizmet verince). Eskiden (entegrator,uuid)
  // unique olduğu için ikinci mükellefin faturası P2002 alıp sessizce atlanıyordu.
  @@unique([tenantId, taxpayerId, entegrator, uuid])
  @@index([tenantId, taxpayerId, faturaDate])
  @@index([tenantId, isTransferred])
  @@index([tenantId, entegrator, syncedAt])
  @@map("efatura_inbox")
}
