{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mali-musavir-app-production.up.railway.app/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mali-musavir-app-production.up.railway.app/api/v1"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mali-musavir-app-production.up.railway.app/api/v1"
      },
      "channel": "production"
    },
    "tarayici": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mali-musavir-app-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_MOREN_APP": "tara"
      },
      "channel": "tarayici"
    },
    "tarayici-ios": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mali-musavir-app-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_MOREN_APP": "tara"
      },
      "channel": "tarayici"
    },
    "tarayici-play": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mali-musavir-app-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_MOREN_APP": "tara"
      },
      "channel": "tarayici"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {}
    }
  }
}
