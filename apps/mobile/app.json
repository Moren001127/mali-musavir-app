{
  "expo": {
    "name": "Moren Mali Müşavirlik",
    "slug": "moren-mobil",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "moren",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0d0b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moren.mobil",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Evrak/fatura fotoğrafı çekmek için kamera izni gerekir.",
        "NSPhotoLibraryUsageDescription": "Galeriden evrak yüklemek için fotoğraf erişimi gerekir.",
        "NSMicrophoneUsageDescription": "Moren AI ekibiyle sesli sohbet etmek için mikrofon izni gerekir.",
        "NSFaceIDUsageDescription": "Hızlı giriş için FaceID kullanılır."
      }
    },
    "android": {
      "package": "com.moren.mobil",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0d0b"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#d4b876"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.morenmusavirlik.com"
    }
  }
}
