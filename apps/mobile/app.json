{
  "expo": {
    "name": "MOREN Müşavir",
    "slug": "moren-mobil",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "moren",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0906"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moren.mobil",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Fatura ve evrak fotoğrafı çekip ofise göndermek için kamera izni gerekir.",
        "NSPhotoLibraryUsageDescription": "Galeriden fatura/evrak görseli seçip ofise göndermek için fotoğraf erişimi gerekir.",
        "NSFaceIDUsageDescription": "Kayıtlı hesabınızla hızlı ve güvenli giriş için Face ID kullanılır."
      }
    },
    "android": {
      "package": "com.moren.mobil",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0906"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kayıtlı hesabınızla hızlı ve güvenli giriş için Face ID kullanılır."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fatura ve evrak fotoğrafı çekip ofise göndermek için kamera izni gerekir.",
          "photosPermission": "Galeriden fatura/evrak görseli seçip ofise göndermek için fotoğraf erişimi gerekir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#d4b876"
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Fatura ve evrak fotoğrafı çekip ofise göndermek için kamera izni gerekir."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://mali-musavir-app-production.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "123489bc-aff1-4fd0-a4f4-901c7b1f91bb"
      }
    },
    "owner": "moren123"
  }
}
